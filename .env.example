# Copy to .env and fill in locally. Never commit .env.
# Names follow PRD §20.2. Values below are blank or verified public endpoints only.

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # server/worker only

# NEAR AI Cloud (OpenAI-compatible). Base URL per near-ai-cloud skill / docs.near.ai, checked 2026-11-04.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=                    # server only — from https://cloud.near.ai

NEAR_NETWORK=testnet
# Public testnet RPC options listed at https://docs.near.org/api/rpc/providers (checked 2026-11-04).
# Final provider choice is made in the technical spike.
NEAR_RPC_URL=
NEAR_PARENT_ACCOUNT_ID=
NEAR_TREASURY_CONTRACT_ID=
NEAR_SIGNER_SECRET=                 # only if the selected safe signer requires it; never commit

OUTLAYER_API_KEY=                   # optional; only if selected
OUTLAYER_BASE_URL=                  # verify testnet/mainnet support first

APP_ENCRYPTION_KEY=                 # for encrypted connector credentials
