# Copy to .env and fill in locally. Never commit .env.
# Names follow PRD §20.2. Values below are blank or verified public endpoints only.

NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # server/worker only

# NEAR AI Cloud (OpenAI-compatible). Base URL per near-ai-cloud skill / docs.near.ai, checked 2026-11-04.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=                    # server only — from https://cloud.near.ai

# AI provider (M2). REQUIRED, no default: the app refuses to run discovery until this is set.
#   mock   = offline, rule-based consultant for development and tests ($0, labelled "Offline demo AI")
#   nearai = NEAR AI Cloud (the product AI). Never falls back to mock; a failure shows "AI unavailable".
AI_PROVIDER=
# NEAR AI spending safeguards. nearai refuses to start unless all three are set.
# Each batch of live calls needs the owner's explicit approval before NEAR_AI_CALLS_APPROVED is set to true.
NEAR_AI_CALLS_APPROVED=
NEAR_AI_MAX_CALLS=
NEAR_AI_MAX_USD_PER_DAY=
# Optional overrides (defaults from PoC-A): structured tasks use Qwen/Qwen3.8-27B.
NEAR_AI_STRUCTURED_MODEL=
NEAR_AI_TIMEOUT_MS=

NEAR_NETWORK=testnet
# Optional. Default: https://archival-rpc.testnet.fastnear.com (keeps old transactions; see M5 B0-4).
NEAR_RPC_URL=
NEAR_PARENT_ACCOUNT_ID=             # the treasury owner account (M5 B1: employai-demo.testnet)
NEAR_TREASURY_CONTRACT_ID=          # M5 B1: treasury.employai-demo.testnet
NEAR_FINANCE_AGENT_ACCOUNT_ID=      # M5 B1: finance-agent.employai-demo.testnet
# The Finance Agent's RESTRICTED function-call key only (treasury.request_payment, no allowance).
# Never a full-access, owner or recovery key: the app refuses any broader key. Set it yourself in
# .env; never commit it, never paste it anywhere else.
NEAR_FINANCE_AGENT_PRIVATE_KEY=

APP_ENCRYPTION_KEY=                 # for encrypted connector credentials
